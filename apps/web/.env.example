# Copy to apps/web/.env.local for local development. Vercel holds the production values.

# Supabase (public: safe in the browser, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical URL used for metadata, sitemaps and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistant: any OpenAI-compatible chat completions endpoint (server-only, never NEXT_PUBLIC_)
OMNIROUTE_BASE_URL=https://router.example.com/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
